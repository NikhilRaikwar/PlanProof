# PlanProof local configuration. Copy this file to .env and fill values locally.
# Never paste secrets into chat, commits, screenshots, or client-side NEXT_PUBLIC_* variables.

# Application
PLANPROOF_ENV=development
PLANPROOF_API_URL=http://localhost:8000
# Comma-separated browser origins. Production should contain the deployed Cloud Run UI URL.
PLANPROOF_WEB_ORIGINS=http://localhost:3000

# MongoDB Atlas — application database user with only this project's access.
# Use a mongodb+srv:// connection string, URL-encode username/password characters.
MONGODB_URI=
MONGODB_DATABASE=planproof

# Redis — local Docker URL initially; use a managed TLS URL in production.
REDIS_URL=redis://localhost:6379/0

# Model providers — server/worker only. Do not create NEXT_PUBLIC_ versions.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=
AIMLAPI_API_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_FALLBACK_MODEL=

# Optional observability. Leave blank during the first local backend milestone.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=planproof-api

# Public GitHub repository ingestion does not need a token in P0.
# Set only later for GitHub App/private-repository functionality.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
