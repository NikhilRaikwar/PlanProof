# PlanProof local configuration. Copy this file to .env and fill values locally.
# Never paste secrets into chat, commits, screenshots, or client-side NEXT_PUBLIC_* variables.

# Application
PLANPROOF_ENV=development
PLANPROOF_API_URL=http://localhost:8000
# Comma-separated browser origins. Production should contain the deployed Cloud Run UI URL.
PLANPROOF_WEB_ORIGINS=http://localhost:3000

# MongoDB Atlas — application database user with only this project's access.
# Use a mongodb+srv:// connection string, URL-encode username/password characters.
MONGODB_URI=
MONGODB_DATABASE=planproof

# Runtime Role: "api" or "worker" (defaults to "api")
PLANPROOF_RUNTIME_ROLE=api

# Cloud Tasks & Scale-to-Zero Worker (Optional in local development; required in production)
PLANPROOF_GCP_PROJECT_ID=planproof-ai
PLANPROOF_CLOUD_TASKS_LOCATION=asia-south1
PLANPROOF_CLOUD_TASKS_QUEUE=planproof-verification-queue
PLANPROOF_WORKER_SERVICE_URL=
PLANPROOF_TASKS_INVOKER_SERVICE_ACCOUNT=
PLANPROOF_SCHEDULER_INVOKER_SERVICE_ACCOUNT=

# Model providers — server/worker only. Do not create NEXT_PUBLIC_ versions.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=
AIMLAPI_API_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_FALLBACK_MODEL=

# Optional observability. Leave blank during the first local backend milestone.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=planproof-api

# GitHub App & User Session Authentication
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Public Beta Quotas & Cost Controls
PLANPROOF_FREE_RUNS_PER_DAY=3
PLANPROOF_FREE_RUNS_PER_MONTH=10
PLANPROOF_GLOBAL_RUNS_PER_DAY=30
PLANPROOF_MAX_ACTIVE_RUNS_PER_ACCOUNT=1
PLANPROOF_MAX_ACTIVE_INGESTIONS_PER_ACCOUNT=1
PLANPROOF_MAX_PROJECTS_PER_ACCOUNT=3
PLANPROOF_SNAPSHOTS_PER_DAY=5
PLANPROOF_MAX_MODEL_CALLS_PER_RUN=3
PLANPROOF_MAX_PROVIDER_ATTEMPTS_PER_RUN=6
PLANPROOF_MAX_MODEL_OUTPUT_TOKENS=3000

# Emergency Kill Switches
PLANPROOF_VERIFICATION_ENABLED=true
PLANPROOF_INGESTION_ENABLED=true

# Ingestion Resource Boundaries
PLANPROOF_MAX_REPO_MANIFEST_FILES=5000
PLANPROOF_MAX_REPO_INDEXABLE_FILES=1000
PLANPROOF_MAX_REPO_WORKSPACE_BYTES=52428800
PLANPROOF_MAX_REPO_INDEXED_BYTES=10485760
