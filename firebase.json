{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/v1/**",
        "run": {
          "serviceId": "planproof-api",
          "region": "asia-south1"
        }
      },
      {
        "source": "/health/**",
        "run": {
          "serviceId": "planproof-api",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "run": {
          "serviceId": "planproof-web",
          "region": "asia-south1"
        }
      }
    ]
  }
}
